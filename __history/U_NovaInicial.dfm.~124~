  object Qry_ContaNotas: TFDQuery
    Connection = dm_Dados.fd_Connection
    SQL.Strings = (
      'SELECT'
      
        '    (SELECT COUNT (A.controle_zerado) from JOGOS_ZERADOS A WHERE' +
        ' A.nota >= 8 AND A.cod_usuario = :USUARIO ) AS MAIORIGUAL8,'
      
        '    (SELECT COUNT (A.controle_zerado) from JOGOS_ZERADOS A WHERE' +
        ' A.nota >= 5 and A.nota <8  AND A.cod_usuario = :USUARIO) AS MAI' +
        'ORQUE5,'
      
        '    (SELECT COUNT (A.controle_zerado) from JOGOS_ZERADOS A WHERE' +
        ' A.nota < 5   AND A.cod_usuario = :USUARIO) AS MENORQUE5'
      '    FROM rdb$database;     ')
    Left = 272
    Top = 481
    ParamData = <
      item
        Name = 'USUARIO'
        DataType = ftInteger
        ParamType = ptInput
        Value = Null
      end>
  end
