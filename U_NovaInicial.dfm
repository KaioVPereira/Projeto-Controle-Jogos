  object Qry_Top10: TFDQuery
    Connection = dm_Dados.fd_Connection
    SQL.Strings = (
      ' SELECT B.nome_jogo, A.nota  FROM jogos_zerados A, jogos B'
      '           WHERE'
      '           A.cod_jogo =  B.controle_jogo AND'
      '           A.cod_usuario = :USUARIO'
      '           ORDER BY A.nota DESC ROWS 10')
    Left = 112
    Top = 192
    ParamData = <
      item
        Name = 'USUARIO'
        DataType = ftInteger
        ParamType = ptInput
        Value = Null
      end>
    object Qry_Top10NOME_JOGO: TStringField
      DisplayLabel = 'Nome do Jogo'
      DisplayWidth = 37
      FieldName = 'NOME_JOGO'
      Origin = 'NOME_JOGO'
      Required = True
      Size = 30
    end
    object Qry_Top10NOTA: TFloatField
      DisplayLabel = 'Nota'
      DisplayWidth = 10
      FieldName = 'NOTA'
      Origin = 'NOTA'
    end
  end
  object DS_Top10: TDataSource
    DataSet = Qry_Top10
    Left = 184
    Top = 192
  end
  object Qry_ContaNotas: TFDQuery
    Connection = dm_Dados.fd_Connection
    SQL.Strings = (
      'SELECT'
      
        '    (SELECT COUNT (A.controle_zerado) from JOGOS_ZERADOS A WHERE' +
        ' A.nota >= 8 AND A.cod_usuario = :USUARIO ) AS MAIORIGUAL8,'
      
        '    (SELECT COUNT (A.controle_zerado) from JOGOS_ZERADOS A WHERE' +
        ' A.nota >= 5 and A.nota <8  AND A.cod_usuario = :USUARIO) AS MAI' +
        'ORQUE5,'
      
        '    (SELECT COUNT (A.controle_zerado) from JOGOS_ZERADOS A WHERE' +
        ' A.nota < 5   AND A.cod_usuario = :USUARIO) AS MENORQUE5'
      '    FROM rdb$database;     ')
    Left = 272
    Top = 561
    ParamData = <
      item
        Name = 'USUARIO'
        DataType = ftInteger
        ParamType = ptInput
        Value = Null
      end>
  end
